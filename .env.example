# Database (backend / ingestion / Chainlit thread persistence)
DATABASE_URL=postgresql+asyncpg://emporium:emporium@db:5432/emporium

# Read-only credentials used by the MCP operational-data server
MCP_DATABASE_URL=postgresql+asyncpg://readonly:readonly@db:5432/emporium

# MCP server endpoint and shared signing secret for customer context
MCP_URL=http://mcp:8000/mcp
MCP_SHARED_SECRET=change-me-in-production
# Host headers accepted by the MCP HTTP transport (DNS-rebinding protection).
MCP_ALLOWED_HOSTS=mcp:*,localhost:*,127.0.0.1:*,[::1]:*

# Local model runtime
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3
OLLAMA_NUM_CTX=4096
# Reasoning/thinking mode for thinking-capable local models. "false" answers
# directly, which is much faster on CPU; "true" enables thinking; "low",
# "medium", "high" set intensity; "none" uses the model default.
OLLAMA_REASONING=false
# Upper bound on generated tokens, to avoid runaway generation.
OLLAMA_NUM_PREDICT=512

# Generation model allowlist (comma-separated LiteLLM model ids)
DEFAULT_MODEL=ollama/qwen3.5:4b
MODEL_ALLOWLIST=ollama/qwen3.5:4b

# Hosted providers (optional). Models listed here appear in the UI only when
# the corresponding API key is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=anthropic/claude-haiku-4-5,anthropic/claude-sonnet-5-5

# Policy retrieval
POLICY_SIMILARITY_THRESHOLD=0.5

# Versioned system prompt (files under prompts/system_prompt_<version>.md)
PROMPT_VERSION=v2

# Frontend: default state of the "Modo debug" chat setting. When enabled, the
# UI shows agent status and tool call/result steps for the current session.
SHOW_AGENT_STEPS=false

# Frontend: thread persistence and admin login. Persistence (and therefore
# resume/recent conversations) is enabled when CHAINLIT_DB_URL is set. The UI
# signs in automatically as a local admin (no password).
CHAINLIT_DB_URL=postgresql+asyncpg://emporium:emporium@db:5432/emporium
CHAINLIT_ADMIN_USER=admin
CHAINLIT_AUTH_SECRET=change-me-in-production
